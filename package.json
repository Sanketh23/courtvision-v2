{
  "name": "courtvision",
  "version": "2.0.0",
  "description": "CourtVision — a web-based basketball playbook app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
