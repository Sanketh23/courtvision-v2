    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.8",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.57.0",
    "@supabase/ssr": "^0.10.3",
